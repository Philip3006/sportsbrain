<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sportsbrain.nightshift-notifications</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/env</string>
        <string>python3</string>
        <string>__SPORTSBRAIN_ROOT__/scripts/night_shift_dispatcher.py</string>
        <string>--state</string>
        <string>__SPORTSBRAIN_STATE__</string>
        <string>notify</string>
    </array>
    <key>StartInterval</key>
    <integer>30</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>__SPORTSBRAIN_RUNTIME_DIR__/nightshift-notifications.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__SPORTSBRAIN_RUNTIME_DIR__/nightshift-notifications.stderr.log</string>
</dict>
</plist>
