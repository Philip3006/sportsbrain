# Betfair Exchange (Agent 3 — Tier-1 Sharp-Quelle).
# Delayed-App-Key ist kostenlos: developer.betfair.com → Application Registration.
# Ohne diese Werte gibt src/tennis/odds/betfair.py sofort None zurück
# (Merger fällt auf Tier 2 zurück — nichts bricht).
BETFAIR_APP_KEY=your_delayed_app_key_here
BETFAIR_USERNAME=your_betfair_username_here
BETFAIR_PASSWORD=your_betfair_password_here
